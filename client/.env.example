# Frontend Environment Configuration
# API Base URL (points to backend Express server)
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=

# Supabase Anonymous/Publishable Public Key
# Found in Supabase Dashboard -> Project Settings -> API (anon/public key)
# WARNING: NEVER place the service_role key here!
VITE_SUPABASE_ANON_KEY=
